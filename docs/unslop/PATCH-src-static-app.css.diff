# Bản vá ĐỀ XUẤT cho src/static/app.css (chưa áp vào src/ - cần chủ đầu tư duyệt)
# Áp thử: git apply --check docs/unslop/PATCH-src-static-app.css.diff  (rồi git apply nếu được duyệt)
# Đã kiểm trên bản sao kho: python -m pytest 185 passed, ruff sạch.
# Thay đổi: thông báo nổi lên đầu màn hình + pointer-events:none; nút lọc (.chip) và Đăng xuất (.logout) 38 → 44 px.
diff --git a/src/static/app.css b/src/static/app.css
index 4061e05..24f0f4f 100644
--- a/src/static/app.css
+++ b/src/static/app.css
@@ -86,7 +86,7 @@ h1 { font-size: 24px; font-weight: 700; }
 }
