# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=<điền tên máy chủ>
DB_NAME=<điền tên CSDL>
# Tài khoản chỉ có quyền đọc (db_datareader) dành cho tác tử AI và báo cáo.
DB_USER_READONLY=<điền>
DB_PASSWORD_READONLY=<điền>
# Tài khoản ghi của ứng dụng (INSERT/UPDATE, không cấp quyền DELETE). Tác tử AI không dùng.
DB_USER_APP=<điền>
DB_PASSWORD_APP=<điền>
